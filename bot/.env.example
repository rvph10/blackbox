# Copier en .env (jamais commité, voir .gitignore).

# --- Discord ---------------------------------------------------------------
# Developer Portal → application BlackBox Bot → Bot → Token
DISCORD_BOT_TOKEN=
# ID du serveur Discord (clic droit sur le serveur → Copier l'identifiant,
# mode développeur activé). Accélère la synchro des slash commands.
DISCORD_GUILD_ID=

# --- Jellyfin (lecture + écriture : création de comptes, ADR-021) --------
JELLYFIN_URL=http://jellyfin:8096
# Jellyfin Dashboard → Advanced → API Keys
JELLYFIN_API_KEY=

# --- Jellystat (stats de visionnage) -----------------------------------
JELLYSTAT_URL=http://jellystat:3000
# Jellystat → Settings → API Keys
JELLYSTAT_API_KEY=

# --- Alertes admin (même webhook que gluetun-healthcheck / backup) --------
ADMIN_ALERT_WEBHOOK_URL=

# --- URLs publiques (mises dans le MP de bienvenue) ----------------------
PUBLIC_STREAM_URL=https://stream.blackbox.homes
PUBLIC_REQUESTS_URL=https://requests.blackbox.homes

# --- Divers -----------------------------------------------------------------
# Chemin de la base SQLite (volume monté en prod). Défaut : /data/bot.db
BOT_DB_PATH=/data/bot.db
# Salon du classement (défaut : #classement)
SCOREBOARD_CHANNEL_ID=1543646643629461628
