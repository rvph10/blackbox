# Copier en .env et adapter. Ne pas committer .env (voir .gitignore).

TZ=Europe/Brussels

# Stockage média : temporaire en local (SSD NucBox) tant que le NAS n'est
# pas branché. À basculer vers le point de montage NFS/SMB du NAS une fois
# disponible (voir docs/adr/003-raid-nas.md).
MEDIA_PATH=./data/media

# GID des groupes video/render sur l'hôte (`getent group video render`) —
# nécessaires pour l'accès VAAPI à /dev/dri (voir docs/adr/006-vaapi-validated.md).
VIDEO_GID=44
RENDER_GID=991
