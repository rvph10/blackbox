# Copier en .env et adapter. Ne pas committer .env (voir .gitignore).

TZ=Europe/Brussels

# Stockage média : point de montage NFS du NAS (dxp, RAID1, voir
# docs/adr/003-raid-nas.md). Monté sur l'hôte via /etc/fstab
# (_netdev,noauto,x-systemd.automount — ne bloque pas le boot si le NAS
# est injoignable). Contient movies/ et tvshows/.
MEDIA_PATH=/mnt/nas-media

# GID des groupes video/render sur l'hôte (`getent group video render`) —
# nécessaires pour l'accès VAAPI à /dev/dri (voir docs/adr/006-vaapi-validated.md).
VIDEO_GID=44
RENDER_GID=991
