# Copier en .env et adapter. Ne pas committer .env (voir .gitignore).

TZ=Europe/Brussels

# Stockage média : point de montage NFS du NAS (dxp, RAID1, voir
# docs/adr/003-raid-nas.md). Monté sur l'hôte via /etc/fstab
# (_netdev,noauto,x-systemd.automount — ne bloque pas le boot si le NAS
# est injoignable). Contient movies/, tvshows/ et downloads/ — même racine
# montée dans Jellyfin (/media) et dans les *arr* apps (/data) pour que les
# hardlinks Sonarr/Radarr fonctionnent (voir docs/adr/007-arr-stack.md).
MEDIA_PATH=/mnt/nas-media

# GID des groupes video/render sur l'hôte (`getent group video render`) —
# nécessaires pour l'accès VAAPI à /dev/dri (voir docs/adr/006-vaapi-validated.md).
VIDEO_GID=44
RENDER_GID=991

# UID/GID de l'utilisateur hôte (`id kong`) — utilisés par les images
# LinuxServer (qbittorrent, prowlarr, sonarr, radarr, bazarr) pour écrire
# sur le NAS avec les bons droits.
PUID=1000
PGID=1000

# VPN Mullvad (WireGuard) pour gluetun — tout le trafic qbittorrent passe
# exclusivement par ce tunnel (kill switch natif de gluetun). Récupérer
# PrivateKey et Address sur mullvad.net/en/account/wireguard-config
# (ne prendre que la partie IPv4 de Address, ex: 10.x.x.x/32).
MULLVAD_PRIVATE_KEY=
MULLVAD_ADDRESSES=
MULLVAD_COUNTRY=Netherlands

# Token du tunnel Cloudflare (conteneur cloudflared). Généré par Terraform :
# `cd infra/terraform && terraform output -raw tunnel_token`. Le tunnel et ses
# règles d'ingress sont gérés dans infra/terraform, jamais ici.
# Voir docs/adr/014-cloudflare-tunnel.md et docs/runbooks/setup-cloudflare-tunnel.md.
TUNNEL_TOKEN=
