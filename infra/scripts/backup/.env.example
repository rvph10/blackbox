# Copier en .env (jamais commité, voir .gitignore).

# Passphrase de chiffrement restic — générée une seule fois, à conserver
# IMPÉRATIVEMENT en dehors du NucBox (gestionnaire de mots de passe). Si
# le NucBox meurt et que cette valeur n'existe nulle part ailleurs, les
# deux dépôts de backup deviennent illisibles.
RESTIC_PASSWORD=

# Même webhook admin que gluetun-healthcheck (Server Settings → Integrations
# → Webhooks côté Discord) — alerte seulement en cas d'échec.
ADMIN_ALERT_WEBHOOK_URL=

# Valeurs par défaut déjà correctes pour ce projet, à ne changer que si
# la structure change.
REPO_LOCAL=/mnt/nas-media/backups/restic
REPO_REMOTE=rclone:gdrive:blackbox-backups
