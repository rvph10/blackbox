# Copier en .env (jamais commité, voir .gitignore) — ADR-019.

# Webhook Discord du salon admin (le même que gluetun-healthcheck / backup).
ADMIN_ALERT_WEBHOOK_URL=

# Webhook Discord du salon communautaire (optionnel). Si renseigné, un
# message d'information y est posté quand le niveau passe CRITIQUE.
COMMUNITY_WEBHOOK_URL=

# API Jellyfin — Dashboard -> Advanced -> API Keys -> nouvelle clé dédiée
# "capacity-watcher". Le script tourne sur l'hôte, donc localhost.
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=

# Point de montage de la médiathèque surveillé pour l'espace disque.
MEDIA_MOUNT=/mnt/nas-media

# Seuils disque (% utilisé).
DISK_WARN_PCT=85
DISK_CRIT_PCT=92

# Seuils débit montant streaming (Mbit/s, valeurs absolues). Calés sur
# ~20 Mbit/s mesurés le 2026-08-29 (VDSL). À remonter après la fibre :
# refaire `speedtest`, ajuster, `systemctl restart capacity-watcher.timer`.
UPLOAD_WARN_MBPS=14
UPLOAD_CRIT_MBPS=17

# qBittorrent WebUI (via le netns gluetun, port publié 8080). Utilisé pour
# basculer les "débits alternatifs" quand le niveau est CRITIQUE. La limite
# alternative d'upload doit être configurée dans qBittorrent
# (Options -> Vitesse -> Débits alternatifs). Laisser vide pour désactiver
# cette action (alertes seules).
QBT_URL=http://localhost:8080
QBT_USER=
QBT_PASS=
